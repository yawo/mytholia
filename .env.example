# GraphOdyssée environment variables. Never commit real values.

# LLM / extraction / narrative generation
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Search-augmented sourcing
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# TTS / voice cloning
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
QWEN_TTS_API_KEY=
GRAPHODYSSEE_DEFAULT_VOICE_ID=

# V1 graph store: local graph.json files
GRAPH_STORE_BACKEND=networkx
DATA_PROCESSED_DIR=data/processed
PODCAST_CACHE_DIR=data/podcasts
CORPORA_DIR=corpora

# V2 graph store: FalkorDB/Memgraph via openCypher
GRAPH_DB_URI=
GRAPH_DB_NAME=graphodyssee
GRAPH_DB_USER=
GRAPH_DB_PASSWORD=
GRAPH_DB_PROVIDER=falkordb

# V2 hybrid retrieval
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=graphodyssee_nodes
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Deployment / runtime
ENVIRONMENT=production
LOG_LEVEL=info
ALLOWED_ORIGINS=
