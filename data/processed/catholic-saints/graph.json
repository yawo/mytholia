{
  "corpus_id": "catholic-saints",
  "nodes": [
    {
      "id": "char_peter",
      "type": "Character",
      "corpus_id": "catholic-saints",
      "label": "Saint Peter",
      "summary": "Apostle and first Pope; originally a fisherman named Simon, renamed Peter (the Rock) by Christ; crucified upside down in Rome.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "June 29"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Saint Peter",
          "summary": "Apôtre et premier pape ; à l'origine un pêcheur nommé Simon, rebaptisé Pierre (le Rocher) par le Christ ; crucifié la tête en bas à Rome."
        }
      }
    },
    {
      "id": "char_paul",
      "type": "Character",
      "corpus_id": "catholic-saints",
      "label": "Saint Paul",
      "summary": "Apostle to the Gentiles; originally Saul of Tarsus, a persecutor of Christians who converted on the road to Damascus; martyred in Rome.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "June 29"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Saint-Paul",
          "summary": "Apôtre des Gentils ; à l'origine Saul de Tarse, persécuteur des chrétiens convertis sur la route de Damas ; martyrisé à Rome."
        }
      }
    },
    {
      "id": "char_francis",
      "type": "Character",
      "corpus_id": "catholic-saints",
      "label": "Saint Francis of Assisi",
      "summary": "Founder of the Franciscan Order; son of a wealthy merchant who embraced poverty; known for preaching to animals and the Canticle of the Sun.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "October 4"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Saint François d'Assise",
          "summary": "Fondateur de l'Ordre Franciscain; fils d'un riche marchand qui a embrassé la pauvreté; connu pour la prédication aux animaux et le Cantique du Soleil."
        }
      }
    },
    {
      "id": "char_thomas_aquinas",
      "type": "Character",
      "corpus_id": "catholic-saints",
      "label": "Saint Thomas Aquinas",
      "summary": "Dominican friar and theologian; author of the Summa Theologica; the leading scholastic philosopher of the Catholic Church.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "January 28"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Saint Thomas d'Aquin",
          "summary": "frère dominicain et théologien; auteur de la Somme Théologique ; le principal philosophe scolastique de l'Église catholique."
        }
      }
    },
    {
      "id": "char_mary",
      "type": "Character",
      "corpus_id": "catholic-saints",
      "label": "Virgin Mary",
      "summary": "Mother of Jesus; venerated as the Theotokos (God-bearer); assumed body and soul into heaven.",
      "source_refs": [
        {
          "text": "Golden Legend",
          "location": "Assumption"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Vierge Marie",
          "summary": "Mère de Jésus ; vénéré comme la Theotokos (porteur de Dieu) ; assumé corps et âme au ciel."
        }
      }
    },
    {
      "id": "char_patrick",
      "type": "Character",
      "corpus_id": "catholic-saints",
      "label": "Saint Patrick",
      "summary": "Apostle of Ireland; enslaved as a youth, he returned to convert the Irish; associated with the shamrock and the expulsion of snakes.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "March 17"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Saint-Patrick",
          "summary": "Apôtre d'Irlande; réduit en esclavage dans sa jeunesse, il revint convertir les Irlandais ; associé au trèfle et à l'expulsion des serpents."
        }
      }
    },
    {
      "id": "place_rome",
      "type": "Place",
      "corpus_id": "catholic-saints",
      "label": "Rome",
      "summary": "The Eternal City; site of the martyrdoms of Peter and Paul; center of the Catholic Church.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "June 29"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Rome",
          "summary": "La Ville éternelle ; site des martyrs de Pierre et Paul ; centre de l’Église catholique."
        }
      }
    },
    {
      "id": "place_assisi",
      "type": "Place",
      "corpus_id": "catholic-saints",
      "label": "Assisi",
      "summary": "Italian town in Umbria; birthplace of Saint Francis and Saint Clare.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "October 4"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Assise",
          "summary": "Ville italienne en Ombrie ; lieu de naissance de saint François et de sainte Claire."
        }
      }
    },
    {
      "id": "place_damascus",
      "type": "Place",
      "corpus_id": "catholic-saints",
      "label": "Damascus",
      "summary": "City where Saul of Tarsus experienced his blinding conversion on the road; renamed Paul.",
      "source_refs": [
        {
          "text": "Acts of the Apostles",
          "location": "chapter 9"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Damas",
          "summary": "Ville où Saul de Tarse connut sur la route sa conversion aveuglante ; renommé Paul."
        }
      }
    },
    {
      "id": "place_irish_sea",
      "type": "Place",
      "corpus_id": "catholic-saints",
      "label": "The Irish Sea",
      "summary": "Waters crossed by Saint Patrick on his mission to Ireland.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "March 17"
        }
      ],
      "i18n": {
        "fr": {
          "label": "La mer d'Irlande",
          "summary": "Waters crossed by Saint Patrick on his mission to Ireland."
        }
      }
    },
    {
      "id": "event_martyrdom_peter",
      "type": "Event",
      "corpus_id": "catholic-saints",
      "label": "Martyrdom of Saint Peter",
      "summary": "The crucifixion of Peter in Rome under Emperor Nero; he asked to be crucified upside down, deeming himself unworthy to die as Christ did.",
      "source_refs": [
        {
          "text": "Butler's Lives of the Saints",
          "location": "June 29"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Martyre de saint Pierre",
          "summary": "La crucifixion de Pierre à Rome sous l'empereur Néron ; il a demandé à être crucifié la tête en bas, se jugeant indigne de mourir comme le Christ."
        }
      }
    },
    {
      "id": "event_conversion_paul",
      "type": "Event",
      "corpus_id": "catholic-saints",
      "label": "Conversion of Saint Paul",
      "summary": "Saul's blinding vision of the risen Christ on the road to Damascus, transforming him from persecutor to apostle.",
      "source_refs": [
        {
          "text": "Acts of the Apostles",
          "location": "chapter 9"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Conversion de saint Paul",
          "summary": "La vision aveuglante de Saül du Christ ressuscité sur le chemin de Damas, le transformant de persécuteur en apôtre."
        }
      }
    },
    {
      "id": "event_council_nicaea",
      "type": "Event",
      "corpus_id": "catholic-saints",
      "label": "Council of Nicaea",
      "summary": "The first ecumenical council (325 AD) that affirmed the divinity of Christ and produced the Nicene Creed.",
      "source_refs": [
        {
          "text": "Golden Legend",
          "location": "325 AD"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Concile de Nicée",
          "summary": "Le premier concile œcuménique (325 après JC) qui affirma la divinité du Christ et produisit le Credo de Nicée."
        }
      }
    },
    {
      "id": "obj_keys",
      "type": "Object",
      "corpus_id": "catholic-saints",
      "label": "Keys of Heaven",
      "summary": "The keys given to Peter by Christ, symbolizing his authority to bind and loose; a symbol of the papacy.",
      "source_refs": [
        {
          "text": "Golden Legend",
          "location": "Matthew 16:19"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Clés du Ciel",
          "summary": "Les clés données à Pierre par le Christ, symbolisant son autorité de lier et de délier ; un symbole de la papauté."
        }
      }
    },
    {
      "id": "concept_canonization",
      "type": "Concept",
      "corpus_id": "catholic-saints",
      "label": "Canonization",
      "summary": "The process by which the Catholic Church declares a person a saint, recognizing their heroic virtue and intercessory power.",
      "source_refs": [
        {
          "text": "Golden Legend",
          "location": "process"
        }
      ],
      "i18n": {
        "fr": {
          "label": "Canonisation",
          "summary": "Processus par lequel l’Église catholique déclare une personne sainte, reconnaissant sa vertu héroïque et son pouvoir d’intercession."
        }
      }
    }
  ],
