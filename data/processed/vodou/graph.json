{
  "corpus_id": "vodou",
  "nodes": [
    {
      "id": "char_legba",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Papa Legba",
      "summary": "Gatekeeper lwa who stands at the spiritual crossroads; intermediary between humanity and the spirit world; invoked first in every ceremony; associated with dogs and the crossroads.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_damballa",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Damballah Wedo",
      "summary": "Creator lwa of the Rada family; serpent spirit of the sky and waters; associated with wisdom, purity, and creation; offerings include white foods and eggs.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_erzulie_freda",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Erzulie Freda",
      "summary": "Rada lwa of love, beauty, and luxury; associated with weeping, jewelry, and the color pink; syncretized with the Mater Dolorosa.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_erzulie_dantor",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Erzulie Dantor",
      "summary": "Petwo lwa of fierce protection and motherhood; warrior spirit; syncretized with Our Lady of Sorrows; protector of women and children.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Petwo"
        }
      ]
    },
    {
      "id": "char_baron_samedi",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Baron Samedi",
      "summary": "Head of the Gede family; lwa of death and the cemetery; guardian of the crossroads between life and death; depicted in a top hat and dark glasses.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Gede"
        }
      ]
    },
    {
      "id": "char_maman_brigitte",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Maman Brigitte",
      "summary": "Consort of Baron Samedi; lwa of cemeteries and death; guards graves and the dead; associated with hot pepper rum.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Gede"
        }
      ]
    },
    {
      "id": "char_ogou",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Ogou",
      "summary": "Lwa of war, iron, and fire; defender of Rada values though he carries weaponry; syncretized with Saint James the Greater.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_kalfu",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Kalfou (Kalfu Legba)",
      "summary": "Petwo counterpart of Papa Legba; trickster lwa who controls the crossroads and the forces of mischief; causes accidents that alter destiny.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Petwo"
        }
      ]
    },
    {
      "id": "char_agwe",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Agwe",
      "summary": "Rada lwa of the sea and marine life; sovereign of the waters; associated with ships, the ocean, and drowned souls.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "place_ginen",
      "type": "Place",
      "corpus_id": "vodou",
      "label": "Ginen",
      "summary": "The spiritual homeland across the sea in Vodou cosmology; origin and destination of the lwa and the ancestors; Africa as the sacred source.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "afterlife"
        }
      ]
    },
    {
      "id": "place_peristil",
      "type": "Place",
      "corpus_id": "vodou",
      "label": "Peristil",
      "summary": "The Vodou temple where ceremonies are held; contains the poto mitan (center post) through which the lwa descend during possession.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "temple"
        }
      ]
    },
    {
      "id": "place_crossroads",
      "type": "Place",
      "corpus_id": "vodou",
      "label": "The Crossroads",
      "summary": "The liminal space between worlds where Legba and Kalfu stand; the threshold between the seen and unseen realms.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "ritual"
        }
      ]
    },
    {
      "id": "obj_poto_mitan",
      "type": "Object",
      "corpus_id": "vodou",
      "label": "Poto Mitan",
      "summary": "The central pillar of the peristil; the axis mundi through which lwa descend to mount their devotees during ceremonies.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "temple"
        }
      ]
    },
    {
      "id": "obj_veve",
      "type": "Object",
      "corpus_id": "vodou",
      "label": "Veve",
      "summary": "Ritual drawings made on the ground with cornmeal to invoke a specific lwa; each lwa has a distinctive veve pattern.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "ritual"
        }
      ]
    },
    {
      "id": "event_possession",
      "type": "Event",
      "corpus_id": "vodou",
      "label": "Spirit Possession",
      "summary": "The central ritual event of Vodou in which a lwa mounts a practitioner (the horse); the possessed person becomes the vessel for the spirit.",
      "source_refs": [
        {
          "text": "Divine Horsemen",
          "location": "ritual"
        }
      ]
    },
    {
      "id": "event_transatlantic",
      "type": "Event",
      "corpus_id": "vodou",
      "label": "The Middle Passage",
      "summary": "The transatlantic voyage that brought enslaved Africans to Saint-Domingue (Haiti); the crucible in which Vodou was forged from West African religions and Catholicism.",
      "source_refs": [
        {
          "text": "Divine Horsemen",
          "location": "history"
        }
      ]
    },
    {
      "id": "concept_rada",
      "type": "Concept",
      "corpus_id": "vodou",
      "label": "Rada",
      "summary": "The cool, sweet-tempered family of lwa rooted in West African (Dahomey) traditions; includes Legba, Damballah, and Agwe; lwa rasin (root lwa).",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "nanchon"
        }
      ]
    },
    {
      "id": "concept_petwo",
      "type": "Concept",
      "corpus_id": "vodou",
      "label": "Petwo",
      "summary": "The hot, volatile family of lwa rooted in the Creole experience of slavery and revolution; includes Erzulie Dantor and Kalfou; associated with fire and power.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "nanchon"
        }
      ]
    },
    {
      "id": "concept_gede",
      "type": "Concept",
      "corpus_id": "vodou",
      "label": "Gede",
      "summary": "The family of lwa associated with death, the cemetery, and sexuality; led by Baron Samedi and Maman Brigitte; known for merriment and irreverence.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "family"
        }
      ]
    },
    {
      "id": "char_ayizan",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Ayizan",
      "summary": "Rada lwa of initiation, purification, and the marketplace; associated with palm fronds and the first step of a Vodou ceremony; protector of the peristil and ritual purity.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_azaka",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Azaka Mede",
      "summary": "Lwa of agriculture, the countryside, and farmers; depicted as a peasant with a straw hat and a makout (straw bag); gentle and generous; associated with Saint Isidore.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_simbi",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "Simbi",
      "summary": "Lwa of fresh water, magic, and sorcery; associated with springs and rivers; appears as a water snake; patron of herbalists and diviners; a Rada family lwa.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "char_marassa",
      "type": "Character",
      "corpus_id": "vodou",
      "label": "The Marassa",
      "summary": "The divine twins of Vodou; lwa of children, duality, and abundance; represented by three arms crossed; the first to receive offerings after Legba; embody the sacred nature of doubling.",
      "source_refs": [
        {
          "text": "Lwa",
          "location": "Rada"
        }
      ]
    },
    {
      "id": "event_haitian_revolution",
      "type": "Event",
      "corpus_id": "vodou",
      "label": "The Haitian Revolution",
      "summary": "The 1791-1804 revolution that ended slavery in Saint-Domingue and created Haiti; Vodou ceremony at Bois Caiman played a catalytic role; Ogou and Erzulie Dantor are associated with the revolutionary struggle.",
      "source_refs": [
        {
          "text": "Divine Horsemen",
          "location": "history"
        }
      ]
    }
  ],
